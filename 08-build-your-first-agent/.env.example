# For VS Code for the Web: you don't need this file. Foundry creates a .env
# file at the workspace root with AZURE_EXISTING_AIPROJECT_ENDPOINT already set.
#
# For any other editor: copy this file to .env in this folder and fill in your values.
#   cp .env.example .env

# Project endpoint: Foundry portal > Home (project overview page)
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Agent name: Foundry portal > Build > Agents
# Optional. The scripts use it-helpdesk-agent if this isn't set.
AGENT_NAME=it-helpdesk-agent
