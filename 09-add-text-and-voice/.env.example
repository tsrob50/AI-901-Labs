# For VS Code for the Web: you don't need this file. Foundry creates a .env
# file at the workspace root with AZURE_EXISTING_AIPROJECT_ENDPOINT already set.
# Add any of the optional settings below to that file if you need them.
#
# For any other editor: copy this file to .env in this folder and fill in your values.
#   cp .env.example .env

# Project endpoint: Foundry portal > Home (project overview page)
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Chat model deployment: Foundry portal > Build > Models
# Optional. The scripts use gpt-5-mini if this isn't set.
AZURE_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Audio model deployment (gpt-audio family): Foundry portal > Build > Models
# Optional. 03_spoken_prompt.py uses gpt-audio-1.5 if this isn't set.
AUDIO_DEPLOYMENT_NAME=gpt-audio-1.5

# Neural voice for 04_speech_app.py. Browse voices in the Voice Gallery.
# Optional. The script uses en-US-AvaMultilingualNeural if this isn't set.
SPEECH_VOICE=en-US-AvaMultilingualNeural

# Optional endpoint overrides. The scripts work these out from the project
# endpoint, so you only need them if the defaults don't work for you.
# LANGUAGE_ENDPOINT=https://<resource-name>.services.ai.azure.com/
# SPEECH_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
