# For VS Code for the Web: you don't need this file. Foundry creates a .env
# file at the workspace root with AZURE_EXISTING_AIPROJECT_ENDPOINT already set.
# Add any of the optional settings below to that file if you need them.
#
# For any other editor: copy this file to .env in this folder and fill in your values.
#   cp .env.example .env

# Project endpoint: Foundry portal > Home (project overview page)
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Chat model deployment (reads the photo): Foundry portal > Build > Models
# Optional. The scripts use gpt-5-mini if this isn't set.
AZURE_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Image model deployment (creates and edits pictures): Foundry portal > Build > Models
# Optional. The scripts use gpt-image-2.5-flare if this isn't set.
IMAGE_DEPLOYMENT_NAME=gpt-image-2.5-flare

# The photo the scripts read. JPEG or PNG, in this folder.
# Optional. The scripts use storm-damage.jpg if this isn't set.
PHOTO_FILE=storm-damage.jpg

# How closely gpt-5-mini looks at the photo: low, high, or auto.
# Optional. The scripts use high if this isn't set.
IMAGE_DETAIL=high

# Optional endpoint override for the image model. The scripts work this out
# from the project endpoint, so you only need it if the default doesn't work.
# IMAGE_ENDPOINT=https://<resource-name>.openai.azure.com/openai/v1/
